<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Title>IVSoftware.GlyphProvider.Portable</Title>
        <PackageId>IVSoftware.GlyphProvider.Portable</PackageId>
        <Description>Portable glyph identity resolver using embedded config.json files shipped alongside custom fonts. Provides ToGlyph extensions, enum prototype generation, and GlyphAttribute for declarative binding.</Description>
        <PackageTags>portable;cross-platform;glyphs;fontello;icons;enum;binding;declarative</PackageTags>
        <RepositoryUrl>https://github.com/IVSoftware/IVSoftware.Portable.GlyphProvider.git</RepositoryUrl>
        <PackageProjectUrl>https://github.com/IVSoftware/IVSoftware.Portable.GlyphProvider.git</PackageProjectUrl>
        <RootNamespace>IVSoftware.Portable</RootNamespace>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Author>Thomas C. Gregor</Author>
        <Owner>IVSoftware LLC</Owner>
        <Copyright>Copyright © 2023-2025 IVSoftware LLC</Copyright>
        <FileVersion>$(AssemblyVersion)</FileVersion>
        <Version>$(AssemblyVersion)</Version>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <PackageReleaseNotes>
            1.1.0 stable update:
            - Decoupled core glyph provider behavior from the IVSoftware.Portable.Collections dependency.
            - Preserved dictionary-shaped provider serialization for compatibility with existing tests and workflows.
            - Improved demo and startup verification coverage across desktop and MAUI targets.
        </PackageReleaseNotes>

        <AssemblyOriginatorKeyFile>D:\PFX\ivsoft-240410.pfx</AssemblyOriginatorKeyFile>
        <DebugType>embedded</DebugType>
        <BaseVersion>1.1.0</BaseVersion>
		<!--RTR @ 1.1.0-->
        <VersionPrefix>$(BaseVersion)</VersionPrefix>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <SignAssembly>true</SignAssembly>
    </PropertyGroup>	

    <!-- Pack the entire icon-basics folder into /content/icon-basics -->
    <ItemGroup>
        <Content Include="Resources\Fonts\icon-basics\**\*.*">
            <Pack>true</Pack>
            <PackagePath>content/icon-basics/</PackagePath>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup>
      <EmbeddedResource Include="config.icon-basics.json" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md">
            <Pack>true</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="IVSoftware.Portable.Common" Version="*" />
        <PackageReference Include="IVSoftware.Portable.Disposable" Version="2.0.0" />
        <PackageReference Include="Newtonsoft.Json" Version="*" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="README\" />
    </ItemGroup>

    <ItemGroup>
        <SmokeTestArtifact Include="..\..\..\smoke-codex.ps1">
            <DestinationPath>..\SmokeTest\smoke-codex.ps1</DestinationPath>
        </SmokeTestArtifact>
        <SmokeTestArtifact Include="..\..\..\SMOKE-CODEX.md">
            <DestinationPath>..\SmokeTest\README.md</DestinationPath>
        </SmokeTestArtifact>
    </ItemGroup>

    <Target Name="MirrorSmokeTestArtifacts" BeforeTargets="BeforeBuild">
        <MakeDir Directories="$(MSBuildThisFileDirectory)..\SmokeTest" />
        <Copy
            SourceFiles="@(SmokeTestArtifact)"
            DestinationFiles="@(SmokeTestArtifact->'$(MSBuildThisFileDirectory)%(DestinationPath)')"
            SkipUnchangedFiles="true" />
    </Target>

</Project>
